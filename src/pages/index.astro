---
import '../styles/global.css';
import ResponsiveImage from '../components/ResponsiveImage.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const asset = (path) => `${baseUrl}${path.replace(/^\/+/, '')}`;
const videoPoster = (path) =>
  asset(`media/${path.replace(/\.[^.]+$/, '-640.webp')}`);

const featuredWorks = [
  {
    title: '竹林阮乐快闪',
    category: 'Motion / Visual Design',
    image: asset('images/竹林阮乐快闪2.png'),
    width: 1974,
    height: 1023,
    description: '围绕传统音乐与东方意象进行视觉设计，呈现节奏、场景和画面包装能力。',
    tools: 'After Effects / Photoshop / Blender',
  },
  {
    title: '油纸伞快闪场景设计',
    category: 'Environment Design',
    image: asset('images/油纸伞快闪场景设计.png'),
    width: 865,
    height: 485,
    description: '展示空间构成、场景氛围、画面层次和视觉叙事能力。',
    tools: 'Blender / Photoshop',
  },
  {
    title: '日落色渲染练习',
    category: 'Lighting / Rendering',
    image: asset('images/日落色4.png'),
    width: 1920,
    height: 1080,
    description: '重点呈现光影控制、色彩调校和最终画面的情绪表达。',
    tools: 'Blender / Color Grading',
  },
];

const galleryImages = [
  { src: 'images/全景廊桥.png', width: 1920, height: 1080 },
  { src: 'images/廓如亭.png', width: 1871, height: 1159 },
  { src: 'images/廓如亭开始界面.png', width: 1883, height: 1180 },
  { src: 'images/廓如亭游戏内.png', width: 1884, height: 1183 },
  { src: 'images/廓如亭游戏内1.png', width: 1883, height: 1182 },
  { src: 'images/廓如亭游戏道具.png', width: 1887, height: 1168 },
];

const videos = [
  {
    title: '皮影主题视频',
    file: asset('videos/piying.mp4'),
    poster: asset('videos/皮影视频封面.png'),
  },
  {
    title: '廓如闻古音',
    file: asset('videos/廓如闻古音.mp4'),
    poster: asset('videos/廓如闻古音封面.png'),
  },
  {
    title: '木语廊桥',
    file: asset('videos/木语廊桥.mp4'),
    poster: asset('videos/木语廊桥封面.png'),
  },
];

const aigcImages = [
  {
    title: 'AI 辅助建模',
    category: '3D Modeling',
    image: asset('AIGC/model/ai建模.png'),
    width: 852,
    height: 1151,
  },
  {
    title: '人物概念设计',
    category: 'Character Design',
    image: asset('AIGC/model/人物.png'),
    width: 1080,
    height: 1080,
  },
  {
    title: '场景渲染 I',
    category: 'Environment Rendering',
    image: asset('AIGC/model/场景渲染3.png'),
    width: 1920,
    height: 1080,
  },
  {
    title: '场景渲染 II',
    category: 'Environment Rendering',
    image: asset('AIGC/model/场景渲染4.png'),
    width: 1920,
    height: 1080,
  },
];

const aigcVideos = [
  {
    title: '幻想光碟',
    category: 'AI Visual Film',
    file: asset('AIGC/video/幻想光碟.mp4'),
    poster: asset('AIGC/video/幻想光碟封面.png'),
  },
  {
    title: '离骚',
    category: 'AI Visual Film',
    file: asset('AIGC/video/离骚.mp4'),
    poster: asset('AIGC/video/离骚封面.png'),
  },
];

const certificates = [
  {
    title: '北京印刷学院证书',
    issuer: '北京印刷学院',
    file: asset('certificates/北京印刷学院-2026058540(1).pdf'),
    preview: asset('certificates/previews/北京印刷学院-2026058540(1).png'),
    previewWidth: 1800,
    previewHeight: 1273,
    previewType: 'image',
  },
  {
    title: '北京印刷学院证书',
    issuer: '北京印刷学院',
    file: asset('certificates/北京印刷学院-2026054074.pdf'),
    preview: asset('certificates/previews/北京印刷学院-2026054074.png'),
    previewWidth: 1800,
    previewHeight: 1273,
    previewType: 'image',
  },
  {
    title: '三等奖证书',
    issuer: '荣誉奖项',
    file: asset('media/certificates/三等奖-1600.webp'),
    preview: asset('certificates/三等奖.png'),
    previewWidth: 794,
    previewHeight: 1123,
    previewType: 'image',
  },
  {
    title: '翻译证书',
    issuer: '能力证明',
    file: asset('certificates/translate_C0014_245020102.pdf'),
    preview: asset('certificates/previews/translate_C0014_245020102.png'),
    previewWidth: 1800,
    previewHeight: 1273,
    previewType: 'image',
  },
  {
    title: '大学英语六级成绩单',
    issuer: 'CET6',
    file: asset('certificates/CET6_202512_110590252202029_1.pdf'),
    preview: asset('certificates/previews/CET6_202512_110590252202029_1.png'),
    previewWidth: 1800,
    previewHeight: 1273,
    previewType: 'image',
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="高紫凌的游戏设计与3D美术作品集，展示古建游戏场景、Blender建模渲染、Unity开发、AIGC创作与项目成果。"
    />
    <link rel="icon" type="image/png" sizes="64x64" href={asset('favicon.png?v=4')} />
    <link rel="shortcut icon" type="image/png" href={asset('favicon.png?v=4')} />
    <title>高紫凌 | 游戏设计与3D美术作品集</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top">高紫凌</a>
      <nav aria-label="主导航">
        <a href="#works">作品</a>
        <a href="#gallery">图片</a>
        <a href="#showreel">视频</a>
        <a href="#aigc">AIGC</a>
        <a href="#certificates">证书</a>
        <a href="#about">关于</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero section-band">
        <div class="hero-copy">
          <p class="eyebrow">Game Art Portfolio</p>
          <h1>高紫凌 · 游戏设计与3D美术</h1>
          <p class="hero-text">
            我专注于游戏场景设计、3D建模与数字内容创作，能够使用Blender完成雕刻、建模、贴图、渲染和动画，并将模型与贴图完整导入Unity。这里展示我的古建游戏项目、场景作品、AIGC探索及阶段性创作成果。
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#works">查看作品</a>
            <a class="button secondary" href="#showreel">播放视频</a>
          </div>
        </div>
        <div class="hero-media" aria-label="首页代表作品图">
          <ResponsiveImage
            src="images/日落色4.png"
            alt="日落色渲染作品预览"
            width={1920}
            height={1080}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </section>

      <section class="intro-strip" aria-label="能力概览">
        <div>
          <strong>3D美术</strong>
          <span>Blender雕刻建模、PBR贴图、灯光渲染与动画</span>
        </div>
        <div>
          <strong>Unity场景</strong>
          <span>模型导入、游戏场景搭建、Shader编写与URP渲染</span>
        </div>
        <div>
          <strong>AI辅助创作</strong>
          <span>Tripo、Meshy、混元及Agent协同的3D工作流</span>
        </div>
      </section>

      <section class="section" id="works">
        <div class="section-heading">
          <p class="eyebrow">Selected Works</p>
          <h2>作品展示</h2>
          <p>精选部分代表作品，展示我的视觉方向、画面处理和项目完成能力。</p>
        </div>
        <div class="work-grid">
          {featuredWorks.map((work) => (
            <article class="work-card">
              <ResponsiveImage
                src={work.image.replace(baseUrl, '')}
                alt={`${work.title}预览图`}
                width={work.width}
                height={work.height}
              />
              <div class="work-card-body">
                <span>{work.category}</span>
                <h3>{work.title}</h3>
                <p>{work.description}</p>
                <small>{work.tools}</small>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section gallery-section" id="gallery">
        <div class="section-heading">
          <p class="eyebrow">Image Gallery</p>
          <h2>图片作品</h2>
          <p>图片区域用于展示视觉成图、场景设计、过程图和作品细节。</p>
        </div>
        <div class="gallery-grid">
          {galleryImages.map((image, index) => (
            <ResponsiveImage
              src={image.src}
              alt={`图片作品 ${index + 1}`}
              width={image.width}
              height={image.height}
            />
          ))}
        </div>
      </section>

      <section class="section video-section" id="showreel">
        <div class="section-heading">
          <p class="eyebrow">Showreel</p>
          <h2>视频播放</h2>
          <p>视频封面使用视频目录中对应的截图文件，点击即可播放完整视频。</p>
        </div>
        <div class="video-grid">
          {videos.map((video) => (
            <article class="video-card">
              <video controls preload="none" poster={videoPoster(video.poster.replace(baseUrl, ''))} playsinline>
                <source src={video.file} type="video/mp4" />
                当前浏览器不支持视频播放。
              </video>
              <h3>{video.title}</h3>
            </article>
          ))}
        </div>
      </section>

      <section class="section aigc-section" id="aigc">
        <div class="aigc-heading">
          <div class="section-heading compact">
            <p class="eyebrow">AIGC Exploration</p>
            <h2>AIGC 创作</h2>
          </div>
          <p>
            将生成式图像、概念设计与三维流程结合，用于探索人物、空间和动态影像的视觉方向。
          </p>
        </div>

        <div class="aigc-image-grid">
          {aigcImages.map((work) => (
            <figure class="aigc-image-card">
              <ResponsiveImage
                src={work.image.replace(baseUrl, '')}
                alt={`${work.title}作品预览`}
                width={work.width}
                height={work.height}
              />
              <figcaption>
                <span>{work.category}</span>
                <strong>{work.title}</strong>
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="aigc-video-grid">
          {aigcVideos.map((video) => (
            <article class="aigc-video-card">
              <video controls preload="none" poster={videoPoster(video.poster.replace(baseUrl, ''))} playsinline>
                <source src={video.file} type="video/mp4" />
                当前浏览器不支持视频播放。
              </video>
              <div>
                <span>{video.category}</span>
                <h3>{video.title}</h3>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="certificates">
        <div class="section-heading">
          <p class="eyebrow">Certificates</p>
          <h2>证书展示</h2>
          <p>证书区域展示我的语言能力、学习经历和相关荣誉，点击可打开原始文件。</p>
        </div>
        <div class="certificate-grid">
          {certificates.map((certificate) => (
            <article class="certificate-card">
              <div class="certificate-preview-wrap">
                <ResponsiveImage
                  class="certificate-preview"
                  src={certificate.preview.replace(baseUrl, '')}
                  alt={`${certificate.title}预览`}
                  width={certificate.previewWidth}
                  height={certificate.previewHeight}
                />
              </div>
              <span>{certificate.title}</span>
              <strong>{certificate.issuer}</strong>
              <a class="certificate-link" href={certificate.file} target="_blank" rel="noreferrer">
                打开原文件
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="section about" id="about">
        <div class="portrait">
          <ResponsiveImage
            src="AIGC/model/人物.png"
            alt="人物设计作品"
            width={1080}
            height={1080}
          />
        </div>
        <div>
          <p class="eyebrow">About</p>
          <h2>作者介绍</h2>
          <p>
            我是高紫凌，北京印刷学院数字媒体技术专业本科生，专业排名前5%，求职方向为游戏设计与3D美术。我熟悉Blender雕刻建模、贴图、渲染和动画流程，并掌握ZBrush、3ds Max、Maya的基本操作；能够完成从Blender到Unity的模型与贴图导出、PBR烘焙、游戏场景搭建及不同渲染管线下的Shader编写。
          </p>
          <p>
            我曾担任古建游戏《廓如闻古音》和《木语廊桥》的主3D美术与策划，项目分别获得2026年全国计算机设计大赛北京市一等奖和三等奖。我也持续探索Tripo、Meshy、混元及Codex、Claude等Agent辅助的3D工作流，并在实习与兼职项目中完成卫星影像修复、建筑模型还原及30余项建模订单，具备从创意策划到作品落地的完整执行能力。
          </p>
        </div>
      </section>
    </main>
  </body>
</html>
